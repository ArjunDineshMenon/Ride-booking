# Local development defaults. Copy to backend/.env to override.
DATABASE_PATH=backend/roam.db
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# Phone sign-in. Development mode shows a test code and sends NO SMS.
# APP_ENV=production refuses to start with development codes enabled.
APP_ENV=development
OTP_MODE=development

# For real phone ownership verification: OTP_MODE=twilio
# Keep credentials in backend/.env, never in frontend source or Git.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Public provider defaults are for a modest-traffic local prototype.
# Use your own providers / instances for a public production service.
GEOCODING_URL=https://nominatim.openstreetmap.org
ROUTING_URL=https://router.project-osrm.org
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAPS_USER_AGENT=RoamRideBooking/1.0 (local development; http://localhost:8000)
